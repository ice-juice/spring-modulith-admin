[Unit]
Description=Refresh the pinned Grype database
After=network-online.target docker.service
[Service]
Type=oneshot
User=sma-worker
Group=sma-worker
EnvironmentFile=/etc/sma-worker/worker.env
ExecStart=/usr/bin/java -Xmx512m -XX:+DisableAttachMechanism -jar /opt/sma-worker/extension-worker.jar refresh-database
WorkingDirectory=/var/lib/sma-worker
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sma-worker /var/cache/sma-grype
TimeoutStartSec=660
