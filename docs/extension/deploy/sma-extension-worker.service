[Unit]
Description=SMA extension validation worker (one job)
After=network-online.target docker.service

[Service]
Type=oneshot
User=sma-worker
Group=sma-worker
EnvironmentFile=/etc/sma-worker/worker.env
ExecStart=/usr/bin/java -Xmx1536m -XX:+DisableAttachMechanism -jar /opt/sma-worker/extension-worker.jar once
WorkingDirectory=/var/lib/sma-worker
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sma-worker /var/cache/sma-grype
TimeoutStartSec=900
